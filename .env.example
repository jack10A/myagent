APP_ENV=local
API_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql+psycopg://myagent:myagent@postgres:5432/myagent
DB_CONNECT_TIMEOUT_SECONDS=2
SKIP_DB_STARTUP=true
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/connectors/github/callback
GITHUB_SCOPES=read:user user:email public_repo

WEATHER_API_KEY=
EMERGENCY_ALERTS_PROVIDER=nws
DEFAULT_ALERT_CITY=New York
DEFAULT_ALERT_LAT=40.7128
DEFAULT_ALERT_LON=-74.0060

NEXT_PUBLIC_API_URL=http://localhost:8000/api
